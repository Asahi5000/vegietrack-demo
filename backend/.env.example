# Local Node API: copy to backend/.env and point only to a local demo database.
DEMO_DB_DRIVER=mysql
DEMO_DB_HOST=localhost
DEMO_DB_PORT=3306
DEMO_DB_NAME=vegietrack_demo
DEMO_DB_USER=replace-with-local-demo-db-user
DEMO_DB_PASSWORD=replace-with-local-demo-db-password

# Generate a unique local signing key; do not reuse production JWT secrets.
DEMO_JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-characters
DEMO_JWT_EXPIRES_IN=2h
DEMO_LOGIN_USERNAME=demo
PORT=5000
