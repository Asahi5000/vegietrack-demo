# Vercel/server-side values. Use a fresh, dedicated demo database and a unique
# signing key. Never reuse production credentials or add secrets with a VITE_ prefix.
DEMO_DB_DRIVER=postgres
DEMO_DATABASE_URL=postgresql://demo_user:replace-with-demo-password@demo-project-host.invalid:6543/vegietrack_demo
DEMO_JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-characters
DEMO_JWT_EXPIRES_IN=2h
DEMO_LOGIN_USERNAME=demo
